<% flash.each do |type, message| %>
  <div class="<%= type.to_s == 'alert' ? 'bg-red-50 border-red-200 text-red-800 dark:bg-red-900/20 dark:border-red-800 dark:text-red-200' : 'bg-emerald-50 border-emerald-200 text-emerald-800 dark:bg-emerald-900/20 dark:border-emerald-800 dark:text-emerald-200' %> border rounded-lg px-4 py-3 mb-4 text-sm font-medium">
    <%= message %>
  </div>
<% end %>
