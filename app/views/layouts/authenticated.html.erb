<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Taskatra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Taskatra">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Resolve theme before paint to prevent flash of wrong mode %>
    <script>
      (function(){var t=localStorage.getItem('taskatra-theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.classList.add('dark')}})();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 antialiased h-screen flex flex-col" data-controller="theme">

    <%# Top navigation bar %>
    <header class="h-14 border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center px-4 flex-shrink-0 z-10">
      <div class="flex items-center gap-3 flex-1">
        <span class="font-bold text-lg tracking-tight text-zinc-900 dark:text-white">Taskatra</span>
      </div>

      <div class="flex items-center gap-2">
        <%# Notification bell — static placeholder, Phase 3 will wire real-time updates %>
        <button class="relative p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors" aria-label="Notifications">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span class="absolute top-1.5 right-1.5 h-4 w-4 rounded-full bg-zinc-200 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 text-[10px] font-semibold flex items-center justify-center leading-none">0</span>
        </button>

        <%# User dropdown via native details/summary %>
        <details class="relative" data-controller="dropdown">
          <summary class="flex items-center gap-2 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors list-none select-none">
            <span class="h-7 w-7 rounded-full bg-violet-600 text-white text-xs font-semibold flex items-center justify-center uppercase">
              <%= current_user.email_address[0] %>
            </span>
            <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300 hidden sm:block max-w-[160px] truncate"><%= current_user.email_address %></span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="absolute right-0 mt-1 w-48 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl shadow-lg py-1 z-50">
            <div class="px-3 py-2 border-b border-zinc-100 dark:border-zinc-700">
              <p class="text-xs text-zinc-500 dark:text-zinc-400 truncate"><%= current_user.email_address %></p>
            </div>
            <%= button_to "Sign out", session_path, method: :delete, class: "w-full text-left px-3 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-700/50 transition-colors" %>
          </div>
        </details>
      </div>
    </header>

    <%# Main content area: sidebar + page content %>
    <div class="flex flex-1 min-h-0">

      <%# Left sidebar %>
      <aside class="w-60 flex-shrink-0 bg-white dark:bg-zinc-900 border-r border-zinc-200 dark:border-zinc-800 flex flex-col">
        <div class="flex-1 overflow-y-auto py-4 px-3">
          <p class="px-2 mb-2 text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Projects</p>
          <% current_user.project_memberships.includes(:project).order("projects.name ASC").each do |membership| %>
            <% project = membership.project %>
            <%= link_to project_path(project),
                  class: "flex items-center gap-2 px-2 py-1.5 rounded-lg text-sm font-medium transition-colors #{ defined?(@project) && @project&.id == project.id ? 'border-l-2 border-violet-600 pl-1 text-violet-700 dark:text-violet-400 bg-violet-50 dark:bg-violet-900/20' : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800' }" do %>
              <span class="h-4 w-4 rounded bg-violet-200 dark:bg-violet-800 flex-shrink-0 text-[9px] font-bold text-violet-700 dark:text-violet-300 flex items-center justify-center uppercase"><%= project.name[0] %></span>
              <span class="truncate"><%= project.name %></span>
            <% end %>
          <% end %>
          <% if current_user.project_memberships.empty? %>
            <div class="text-sm text-zinc-400 dark:text-zinc-600 px-2 py-1 italic">No projects yet</div>
          <% end %>
        </div>

        <div class="flex-shrink-0 border-t border-zinc-100 dark:border-zinc-800 p-3">
          <%= link_to new_project_path, class: "flex items-center gap-2 px-2 py-2 rounded-lg text-sm font-medium text-violet-600 dark:text-violet-400 hover:bg-violet-50 dark:hover:bg-violet-900/20 transition-colors" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            New Project
          <% end %>
        </div>
      </aside>

      <%# Page content %>
      <main class="flex-1 overflow-y-auto p-6">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    </div>

    <%# Task drawer — populated by drawer_controller.js (Plan 02-08) when a card is clicked %>
    <div id="task-drawer-backdrop"
         class="fixed inset-0 bg-black/30 z-40 hidden"
         data-action="click->drawer#close">
    </div>

    <turbo-frame id="task-drawer"
                 class="fixed inset-y-0 right-0 w-[480px] z-50 translate-x-full transition-transform duration-300 ease-out bg-white dark:bg-zinc-900 shadow-2xl overflow-y-auto border-l border-zinc-200 dark:border-zinc-800"
                 data-controller="drawer">
    </turbo-frame>
  </body>
</html>
