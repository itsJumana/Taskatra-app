<% content_for(:title, "Members — #{@project.name}") %>

<div class="max-w-2xl">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-100"><%= @project.name %></h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">Members</p>
    </div>
    <%= link_to "Back to board",
          project_path(@project),
          class: "text-sm text-amber-600 dark:text-amber-400 hover:underline" %>
  </div>

  <% if project_owner? %>
    <section class="rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 mb-6">
      <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-3">Invite a teammate</h2>
      <%= form_with url: project_memberships_path(@project),
            class: "flex items-stretch gap-2" do |f| %>
        <%= f.email_field :email,
              required: true,
              placeholder: "teammate@example.com",
              class: "flex-1 px-3 py-2 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-amber-500" %>
        <%= f.submit "Invite", class: "btn-primary cursor-pointer" %>
      <% end %>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2">Invitee must already have an account.</p>
    </section>
  <% end %>

  <section class="rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 overflow-hidden">
    <ul class="divide-y divide-zinc-100 dark:divide-zinc-800">
      <%= render partial: "member_row", collection: @memberships, as: :membership %>
    </ul>
  </section>
</div>
