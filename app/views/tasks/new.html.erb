<% content_for :title, "New Task — Taskatra" %>

<div class="max-w-xl mx-auto">
  <div class="mb-6">
    <h1 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">New Task</h1>
    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
      Creating in project: <%= link_to @project.name, project_path(@project), class: "text-violet-600 dark:text-violet-400 hover:underline" %>
    </p>
  </div>

  <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-6">
    <%= form_with model: [@project, @task], url: project_tasks_path(@project) do |f| %>
      <%= render "form", f: f, task: @task, project: @project %>
    <% end %>
  </div>
</div>
