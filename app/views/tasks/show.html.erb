<%= turbo_frame_tag "task-drawer" do %>
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between px-5 py-4 border-b border-zinc-100 dark:border-zinc-800 flex-shrink-0">
      <div class="flex items-center gap-2">
        <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500 uppercase tracking-wide">Task</span>
        <span class="text-xs text-zinc-300 dark:text-zinc-600">#<%= @task.id %></span>
      </div>
      <div class="flex items-center gap-1">
        <% if project_member? || project_owner? %>
          <%= link_to "Edit", edit_task_path(@task),
                class: "text-xs font-medium text-zinc-500 dark:text-zinc-400
                        hover:text-zinc-700 dark:hover:text-zinc-200
                        px-2 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors" %>
          <%= button_to "Delete", task_path(@task), method: :delete,
                data: { turbo_confirm: "Delete this task? This cannot be undone." },
                class: "text-xs font-medium text-red-500 dark:text-red-400
                        hover:text-red-700 dark:hover:text-red-300
                        px-2 py-1 rounded hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" %>
        <% end %>
        <button type="button"
                data-action="drawer#close"
                class="ml-2 p-1.5 rounded-lg text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200
                       hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
                aria-label="Close drawer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="flex-1 overflow-y-auto px-5 py-4">
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 leading-snug mb-4">
        <%= @task.title %>
      </h2>

      <div class="flex flex-wrap items-center gap-2 mb-5">
        <span class="text-xs px-2 py-1 rounded-full font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">
          <%= @task.status.split("_").map(&:capitalize).join(" ") %>
        </span>
        <span class="text-xs px-2 py-1 rounded-full font-medium <%= priority_badge_classes(@task.priority) %>">
          <%= priority_label(@task.priority) %>
        </span>
        <% if @task.due_date %>
          <span class="text-xs px-2 py-1 rounded-full font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
            Due <%= @task.due_date.strftime("%B %-d, %Y") %>
          </span>
        <% end %>
      </div>

      <div class="mb-5">
        <p class="text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wide mb-1.5">Assignee</p>
        <% if @task.assignee %>
          <div class="flex items-center gap-2">
            <span class="h-7 w-7 rounded-full bg-amber-500 text-zinc-950 text-xs font-bold
                         flex items-center justify-center uppercase flex-shrink-0">
              <%= @task.assignee.email_address[0] %>
            </span>
            <span class="text-sm text-zinc-700 dark:text-zinc-300"><%= @task.assignee.email_address %></span>
          </div>
        <% else %>
          <span class="text-sm text-zinc-400 dark:text-zinc-500 italic">Unassigned</span>
        <% end %>
      </div>

      <div class="mb-4">
        <p class="text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wide mb-1.5">Description</p>
        <% if @task.description.present? %>
          <div class="text-sm text-zinc-700 dark:text-zinc-300 whitespace-pre-wrap leading-relaxed">
            <%= @task.description %>
          </div>
        <% else %>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 italic">No description provided.</p>
        <% end %>
      </div>

      <div class="mt-6 border-t border-zinc-100 dark:border-zinc-800 pt-4" data-controller="character-count">
        <p class="text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wide mb-2">
          Comments <span class="text-zinc-300 dark:text-zinc-600 font-normal">(Phase 3)</span>
        </p>
        <textarea rows="3"
                  placeholder="Leave a comment… (coming in Phase 3)"
                  disabled
                  data-character-count-target="input"
                  data-action="input->character-count#update"
                  class="w-full text-sm px-3 py-2 bg-zinc-50 dark:bg-zinc-800/50
                         border border-zinc-200 dark:border-zinc-700 rounded-lg
                         text-zinc-400 dark:text-zinc-500 placeholder-zinc-300 dark:placeholder-zinc-600
                         resize-none cursor-not-allowed opacity-60"></textarea>
        <p class="text-xs text-zinc-300 dark:text-zinc-600 mt-1 text-right"
           data-character-count-target="count">0 / 2000</p>
      </div>
    </div>
  </div>
<% end %>
