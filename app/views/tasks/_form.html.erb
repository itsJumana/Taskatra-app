<% if task.errors.any? %>
  <div class="mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
    <p class="text-xs font-semibold text-red-700 dark:text-red-300 mb-1">
      <%= pluralize(task.errors.count, "error") %> prevented saving:
    </p>
    <ul class="list-disc list-inside space-y-0.5">
      <% task.errors.each do |error| %>
        <li class="text-xs text-red-600 dark:text-red-400"><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="mb-4">
  <%= f.label :title, class: "block text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide mb-1" %>
  <%= f.text_field :title,
        placeholder: "Task title",
        class: "w-full text-sm px-3 py-2 bg-white dark:bg-zinc-800
                border border-zinc-300 dark:border-zinc-600 rounded-lg
                text-zinc-800 dark:text-zinc-100
                placeholder-zinc-400 dark:placeholder-zinc-500
                focus:outline-none focus:ring-2 focus:ring-violet-500/50
                focus:border-violet-500 transition-colors" %>
</div>

<div class="mb-4">
  <%= f.label :status, class: "block text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide mb-1" %>
  <%= f.select :status,
        Task::STATUSES.map { |s| [s.split("_").map(&:capitalize).join(" "), s] },
        { selected: task.status.presence || "backlog" },
        class: "w-full text-sm px-3 py-2 bg-white dark:bg-zinc-800
                border border-zinc-300 dark:border-zinc-600 rounded-lg
                text-zinc-800 dark:text-zinc-100
                focus:outline-none focus:ring-2 focus:ring-violet-500/50
                focus:border-violet-500 transition-colors" %>
</div>

<div class="mb-4">
  <label class="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide mb-1">
    Priority
  </label>
  <div class="relative" data-controller="task-dropdown">
    <%= f.hidden_field :priority, value: task.priority || Task::PRIORITIES[:medium],
          data: { "task-dropdown-target": "input" } %>
    <button type="button"
            data-action="task-dropdown#toggle"
            class="w-full flex items-center justify-between text-sm px-3 py-2 bg-white dark:bg-zinc-800
                   border border-zinc-300 dark:border-zinc-600 rounded-lg
                   text-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-2
                   focus:ring-violet-500/50 focus:border-violet-500 transition-colors">
      <span data-task-dropdown-target="label">
        <%= priority_label(task.priority || Task::PRIORITIES[:medium]) %>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    <div class="hidden absolute top-full left-0 right-0 mt-1 bg-white dark:bg-zinc-800
                border border-zinc-200 dark:border-zinc-700 rounded-lg shadow-lg z-10 overflow-hidden"
         data-task-dropdown-target="menu">
      <% Task::PRIORITIES.each do |name, value| %>
        <button type="button"
                class="w-full text-left px-3 py-2 text-sm hover:bg-zinc-50 dark:hover:bg-zinc-700/50
                       text-zinc-700 dark:text-zinc-300 transition-colors"
                data-action="task-dropdown#select"
                data-value="<%= value %>"
                data-label="<%= name.to_s.capitalize %>">
          <%= name.to_s.capitalize %>
        </button>
      <% end %>
    </div>
  </div>
</div>

<div class="mb-4">
  <%= f.label :due_date, class: "block text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide mb-1" %>
  <%= f.date_field :due_date,
        class: "w-full text-sm px-3 py-2 bg-white dark:bg-zinc-800
                border border-zinc-300 dark:border-zinc-600 rounded-lg
                text-zinc-800 dark:text-zinc-100
                focus:outline-none focus:ring-2 focus:ring-violet-500/50
                focus:border-violet-500 transition-colors" %>
</div>

<div class="mb-4">
  <label class="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide mb-1">
    Assignee
  </label>
  <div class="relative" data-controller="task-dropdown">
    <%= f.hidden_field :assignee_id, value: task.assignee_id,
          data: { "task-dropdown-target": "input" } %>
    <button type="button"
            data-action="task-dropdown#toggle"
            class="w-full flex items-center justify-between text-sm px-3 py-2 bg-white dark:bg-zinc-800
                   border border-zinc-300 dark:border-zinc-600 rounded-lg
                   text-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-2
                   focus:ring-violet-500/50 focus:border-violet-500 transition-colors">
      <span data-task-dropdown-target="label">
        <% if task.assignee %>
          <%= task.assignee.email_address %>
        <% else %>
          Unassigned
        <% end %>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    <div class="hidden absolute top-full left-0 right-0 mt-1 bg-white dark:bg-zinc-800
                border border-zinc-200 dark:border-zinc-700 rounded-lg shadow-lg z-10 overflow-hidden"
         data-task-dropdown-target="menu">
      <button type="button"
              class="w-full text-left px-3 py-2 text-sm hover:bg-zinc-50 dark:hover:bg-zinc-700/50
                     text-zinc-400 dark:text-zinc-500 italic transition-colors"
              data-action="task-dropdown#select"
              data-value=""
              data-label="Unassigned">
        Unassigned
      </button>
      <% project.project_memberships.includes(:user).each do |membership| %>
        <button type="button"
                class="w-full text-left px-3 py-2 text-sm hover:bg-zinc-50 dark:hover:bg-zinc-700/50
                       text-zinc-700 dark:text-zinc-300 transition-colors"
                data-action="task-dropdown#select"
                data-value="<%= membership.user_id %>"
                data-label="<%= membership.user.email_address %>">
          <div class="flex items-center gap-2">
            <span class="h-5 w-5 rounded-full bg-violet-500 text-white text-[10px] font-bold
                         flex items-center justify-center flex-shrink-0 uppercase">
              <%= membership.user.email_address[0] %>
            </span>
            <%= membership.user.email_address %>
          </div>
        </button>
      <% end %>
    </div>
  </div>
</div>

<div class="mb-5" data-controller="character-count">
  <%= f.label :description, class: "block text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide mb-1" %>
  <%= f.text_area :description,
        placeholder: "Add a description…",
        rows: 4,
        data: { "character-count-target": "input", action: "input->character-count#update" },
        class: "w-full text-sm px-3 py-2 bg-white dark:bg-zinc-800
                border border-zinc-300 dark:border-zinc-600 rounded-lg
                text-zinc-800 dark:text-zinc-100
                placeholder-zinc-400 dark:placeholder-zinc-500
                focus:outline-none focus:ring-2 focus:ring-violet-500/50
                focus:border-violet-500 transition-colors resize-none" %>
  <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-1 text-right"
     data-character-count-target="count">
    0 / 2000
  </p>
</div>

<div class="flex gap-2">
  <%= f.submit class: "flex-1 text-sm font-medium px-4 py-2 bg-violet-600 hover:bg-violet-700
                        text-white rounded-lg transition-colors cursor-pointer" %>
  <%= link_to "Cancel", project_path(project),
        class: "flex-1 text-center text-sm font-medium px-4 py-2 bg-zinc-100 dark:bg-zinc-800
                hover:bg-zinc-200 dark:hover:bg-zinc-700
                text-zinc-700 dark:text-zinc-300 rounded-lg transition-colors" %>
</div>
