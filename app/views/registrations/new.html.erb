<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">Create your account</h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Start managing tasks with your team</p>
    </div>

    <%= form_with model: @user, url: registration_path, class: "space-y-4" do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-800 dark:bg-red-900/20 dark:border-red-800 dark:text-red-200 rounded-lg px-4 py-3 text-sm">
          <% @user.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
            class: "w-full px-3 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors",
            placeholder: "you@example.com" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password",
            class: "w-full px-3 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors",
            placeholder: "Choose a strong password", maxlength: 72 %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
            class: "w-full px-3 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors",
            placeholder: "Repeat your password", maxlength: 72 %>
      </div>

      <%= form.submit "Create account", class: "w-full btn-primary justify-center cursor-pointer" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-zinc-500 dark:text-zinc-400">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "font-medium text-amber-600 dark:text-amber-400 hover:underline" %>
    </p>
  </div>
</div>
