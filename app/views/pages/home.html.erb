<% content_for :title, "Taskflow — Ship together" %>

<div data-controller="theme">

  <%# ── Navigation ────────────────────────────────────────────── %>
  <header class="fixed top-0 inset-x-0 z-50 nav-blur bg-zinc-50/80 dark:bg-zinc-950/80 border-b border-zinc-200/50 dark:border-zinc-800/50">
    <nav class="max-w-7xl mx-auto px-5 md:px-8 h-14 flex items-center justify-between gap-6">

      <a href="/" class="text-[15px] font-semibold tracking-tight flex-shrink-0">
        <span class="text-zinc-900 dark:text-zinc-100">task</span><span class="text-amber-500">flow</span>
      </a>

      <div class="hidden md:flex items-center gap-7 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="#features"     class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors duration-150">Features</a>
        <a href="#how-it-works" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors duration-150">How it works</a>
        <a href="#tech"         class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors duration-150">Stack</a>
      </div>

      <div class="flex items-center gap-2.5 ml-auto">
        <button
          data-action="click->theme#toggle"
          aria-label="Toggle color theme"
          class="w-9 h-9 rounded-lg flex items-center justify-center text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors duration-150">
          <%# Sun — visible in dark mode %>
          <svg class="w-[17px] h-[17px] hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <%# Moon — visible in light mode %>
          <svg class="w-[17px] h-[17px] block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <a href="#" class="btn-primary">
          Get started
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </nav>
  </header>


  <%# ── Hero ──────────────────────────────────────────────────── %>
  <section class="min-h-[100dvh] flex items-center bg-zinc-50 dark:bg-zinc-950 pt-14">
    <div class="max-w-7xl mx-auto px-5 md:px-8 w-full">
      <div class="grid md:grid-cols-[1fr_1.2fr] gap-10 xl:gap-16 items-center py-20 md:py-0">

        <%# Left: headline + CTA %>
        <div class="hero-stagger">
          <p class="text-[11px] font-bold text-amber-500 tracking-[0.2em] uppercase mb-5">
            Collaborative task management
          </p>
          <h1 class="text-5xl md:text-6xl xl:text-[4.5rem] font-bold tracking-tight leading-[1.04] text-zinc-900 dark:text-zinc-50 mb-5">
            Work moves<br>forward here.
          </h1>
          <p class="text-[17px] text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-[44ch] mb-9">
            A shared workspace for teams that ship. Assign tasks, track progress, and see changes as they happen — no Redis, no Sidekiq, no overhead.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="#" class="btn-primary text-[15px] px-5 py-2.5">
              Start for free
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#how-it-works" class="btn-ghost text-[15px] px-5 py-2.5">
              See how it works
            </a>
          </div>
        </div>

        <%# Right: Kanban board mockup %>
        <div class="hidden md:flex justify-center md:justify-end">
          <div class="board-float w-full max-w-[500px]">
            <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-2xl shadow-zinc-200/60 dark:shadow-zinc-950/80 overflow-hidden">

              <%# App chrome %>
              <div class="flex items-center gap-1.5 px-4 py-3 border-b border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/70"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-400/70"></span>
                <span class="ml-3 text-xs font-medium text-zinc-400">Q2 Launch &mdash; taskflow</span>
                <div class="ml-auto flex items-center gap-2.5">
                  <div class="flex -space-x-1.5">
                    <div class="w-[18px] h-[18px] rounded-full bg-amber-400 ring-[1.5px] ring-white dark:ring-zinc-900 text-[7px] flex items-center justify-center font-bold text-zinc-900">A</div>
                    <div class="w-[18px] h-[18px] rounded-full bg-sky-400 ring-[1.5px] ring-white dark:ring-zinc-900 text-[7px] flex items-center justify-center font-bold text-white">K</div>
                    <div class="w-[18px] h-[18px] rounded-full bg-violet-400 ring-[1.5px] ring-white dark:ring-zinc-900 text-[7px] flex items-center justify-center font-bold text-white">M</div>
                    <div class="w-[18px] h-[18px] rounded-full bg-rose-400 ring-[1.5px] ring-white dark:ring-zinc-900 text-[7px] flex items-center justify-center font-bold text-white">R</div>
                  </div>
                </div>
              </div>

              <%# Board columns %>
              <div class="p-3.5">
                <div class="grid grid-cols-3 gap-3">

                  <%# To Do column %>
                  <div>
                    <div class="flex items-center gap-1.5 mb-2 px-0.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
                      <span class="text-[11px] font-semibold text-zinc-400 dark:text-zinc-500 tracking-wide uppercase">To Do</span>
                      <span class="ml-auto text-[10px] text-zinc-300 dark:text-zinc-600 font-mono">3</span>
                    </div>
                    <div class="space-y-1.5">
                      <div class="bg-zinc-50 dark:bg-zinc-800/70 border border-zinc-100 dark:border-zinc-700/60 rounded-lg p-2.5">
                        <p class="text-[11px] font-medium text-zinc-700 dark:text-zinc-300 leading-snug mb-2">Set up CI pipeline</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">high</span>
                          <div class="w-4 h-4 rounded-full bg-violet-400 text-[7px] flex items-center justify-center font-bold text-white">M</div>
                        </div>
                      </div>
                      <div class="bg-zinc-50 dark:bg-zinc-800/70 border border-zinc-100 dark:border-zinc-700/60 rounded-lg p-2.5">
                        <p class="text-[11px] font-medium text-zinc-700 dark:text-zinc-300 leading-snug mb-2">Onboarding docs</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-zinc-100 dark:bg-zinc-700 text-zinc-500 dark:text-zinc-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">med</span>
                          <div class="w-4 h-4 rounded-full bg-sky-400 text-[7px] flex items-center justify-center font-bold text-white">K</div>
                        </div>
                      </div>
                      <div class="bg-zinc-50 dark:bg-zinc-800/70 border border-zinc-100 dark:border-zinc-700/60 rounded-lg p-2.5">
                        <p class="text-[11px] font-medium text-zinc-700 dark:text-zinc-300 leading-snug mb-2">Mobile breakpoints</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-zinc-100 dark:bg-zinc-700 text-zinc-500 dark:text-zinc-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">low</span>
                          <div class="w-4 h-4 rounded-full bg-rose-400 text-[7px] flex items-center justify-center font-bold text-white">R</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <%# Active column %>
                  <div>
                    <div class="flex items-center gap-1.5 mb-2 px-0.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 pulse-dot"></span>
                      <span class="text-[11px] font-semibold text-zinc-400 dark:text-zinc-500 tracking-wide uppercase">Active</span>
                      <span class="ml-auto text-[10px] text-zinc-300 dark:text-zinc-600 font-mono">2</span>
                    </div>
                    <div class="space-y-1.5">
                      <div class="bg-amber-50/60 dark:bg-amber-950/20 border border-amber-200/70 dark:border-amber-800/30 rounded-lg p-2.5">
                        <p class="text-[11px] font-medium text-zinc-700 dark:text-zinc-300 leading-snug mb-2">API rate limiting</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">high</span>
                          <div class="w-4 h-4 rounded-full bg-amber-400 text-[7px] flex items-center justify-center font-bold text-zinc-900">A</div>
                        </div>
                      </div>
                      <div class="bg-zinc-50 dark:bg-zinc-800/70 border border-zinc-100 dark:border-zinc-700/60 rounded-lg p-2.5">
                        <p class="task-completing text-[11px] font-medium text-zinc-700 dark:text-zinc-300 leading-snug mb-2">Update design tokens</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-zinc-100 dark:bg-zinc-700 text-zinc-500 dark:text-zinc-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">med</span>
                          <div class="w-4 h-4 rounded-full bg-violet-400 text-[7px] flex items-center justify-center font-bold text-white">M</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <%# Done column %>
                  <div>
                    <div class="flex items-center gap-1.5 mb-2 px-0.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      <span class="text-[11px] font-semibold text-zinc-400 dark:text-zinc-500 tracking-wide uppercase">Done</span>
                      <span class="ml-auto text-[10px] text-zinc-300 dark:text-zinc-600 font-mono">5</span>
                    </div>
                    <div class="space-y-1.5 opacity-60">
                      <div class="bg-zinc-50 dark:bg-zinc-800/70 border border-zinc-100 dark:border-zinc-700/60 rounded-lg p-2.5">
                        <p class="text-[11px] font-medium text-zinc-500 line-through leading-snug mb-2">Auth flow</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">done</span>
                          <div class="w-4 h-4 rounded-full bg-sky-400 text-[7px] flex items-center justify-center font-bold text-white">K</div>
                        </div>
                      </div>
                      <div class="bg-zinc-50 dark:bg-zinc-800/70 border border-zinc-100 dark:border-zinc-700/60 rounded-lg p-2.5">
                        <p class="text-[11px] font-medium text-zinc-500 line-through leading-snug mb-2">DB migrations</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">done</span>
                          <div class="w-4 h-4 rounded-full bg-rose-400 text-[7px] flex items-center justify-center font-bold text-white">R</div>
                        </div>
                      </div>
                      <div class="bg-zinc-50 dark:bg-zinc-800/70 border border-zinc-100 dark:border-zinc-700/60 rounded-lg p-2.5">
                        <p class="text-[11px] font-medium text-zinc-500 line-through leading-snug mb-2">Seed data</p>
                        <div class="flex items-center justify-between">
                          <span class="text-[9px] bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase">done</span>
                          <div class="w-4 h-4 rounded-full bg-amber-400 text-[7px] flex items-center justify-center font-bold text-zinc-900">A</div>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>

                <%# Status bar %>
                <div class="mt-3.5 pt-3 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between">
                  <div class="flex items-center gap-1.5 text-[11px] text-zinc-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-dot-3"></span>
                    <span>3 updates today</span>
                  </div>
                  <span class="text-[11px] text-zinc-300 dark:text-zinc-600">Updated just now</span>
                </div>

              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <%# ── Features ───────────────────────────────────────────────── %>
  <section id="features" class="bg-white dark:bg-zinc-900/20 py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">

      <div class="mb-14" data-reveal>
        <p class="text-[11px] font-bold text-amber-500 tracking-[0.2em] uppercase mb-4">Features</p>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight max-w-sm">
          Everything<br>your team needs.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">

        <%# Wide: Real-time %>
        <div class="feature-tile lg:col-span-2 md:flex gap-8 items-start" data-reveal>
          <div class="flex-1 mb-6 md:mb-0">
            <div class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center mb-5">
              <svg class="w-[18px] h-[18px] text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">Real-time collaboration</h3>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-[36ch]">
              See changes as they happen. When a teammate moves a task, you know immediately — no refresh, no polling. WebSockets via Solid Cable.
            </p>
          </div>
          <div class="flex-shrink-0 w-full md:w-52 bg-zinc-50 dark:bg-zinc-800/60 rounded-xl p-4 space-y-2.5">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-dot flex-shrink-0"></span>
              <span class="text-xs text-zinc-600 dark:text-zinc-400">Amara marked a task done</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500 pulse-dot-2 flex-shrink-0"></span>
              <span class="text-xs text-zinc-600 dark:text-zinc-400">Kofi added a comment</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 pulse-dot-3 flex-shrink-0"></span>
              <span class="text-xs text-zinc-600 dark:text-zinc-400">Mira moved a task to Active</span>
            </div>
          </div>
        </div>

        <%# No external services %>
        <div class="feature-tile" data-reveal data-reveal-delay="1">
          <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-5">
            <svg class="w-[18px] h-[18px] text-zinc-600 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">No external services</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            Cache, jobs, and WebSockets all run on your existing database. No Redis. No Sidekiq. No separate billing.
          </p>
        </div>

        <%# Task assignment %>
        <div class="feature-tile" data-reveal data-reveal-delay="1">
          <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-5">
            <svg class="w-[18px] h-[18px] text-zinc-600 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">Task assignment</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            Assign tasks to teammates, set priorities and due dates. Everyone knows what to work on.
          </p>
        </div>

        <%# Subtasks %>
        <div class="feature-tile" data-reveal data-reveal-delay="2">
          <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-5">
            <svg class="w-[18px] h-[18px] text-zinc-600 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">Subtasks</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            Break large items down into steps. Track granular progress without losing sight of the whole.
          </p>
        </div>

        <%# System theming %>
        <div class="feature-tile" data-reveal data-reveal-delay="3">
          <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-5">
            <svg class="w-[18px] h-[18px] text-zinc-600 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">System-aware theming</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            Dark and light mode. Follows your OS or toggle manually. Preference persists across sessions.
          </p>
        </div>

      </div>
    </div>
  </section>


  <%# ── How It Works ───────────────────────────────────────────── %>
  <section id="how-it-works" class="bg-zinc-50 dark:bg-zinc-950 py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">

      <div class="mb-16" data-reveal>
        <p class="text-[11px] font-bold text-amber-500 tracking-[0.2em] uppercase mb-4">How it works</p>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight">
          Up and running<br>in minutes.
        </h2>
      </div>

      <div class="relative">
        <%# Connecting line — desktop only %>
        <div class="hidden md:block absolute top-[26px] left-[calc(16.5%+14px)] right-[calc(16.5%+14px)] h-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></div>

        <div class="grid md:grid-cols-3 gap-0 md:gap-8">

          <div class="relative flex md:block gap-5 md:gap-0 pb-12 md:pb-0" data-reveal>
            <div class="w-[52px] h-[52px] rounded-2xl bg-amber-500 text-zinc-950 font-bold text-base flex items-center justify-center flex-shrink-0 relative z-10">01</div>
            <div class="md:mt-7">
              <h3 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">Create a workspace</h3>
              <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-[28ch]">
                Sign up and name your project. Invite teammates by email. Your board is ready in under two minutes.
              </p>
            </div>
            <div class="absolute left-[25px] top-[52px] bottom-0 w-px bg-zinc-200 dark:bg-zinc-800 md:hidden" aria-hidden="true"></div>
          </div>

          <div class="relative flex md:block gap-5 md:gap-0 pb-12 md:pb-0" data-reveal data-reveal-delay="2">
            <div class="w-[52px] h-[52px] rounded-2xl bg-zinc-900 dark:bg-zinc-100 text-zinc-50 dark:text-zinc-900 font-bold text-base flex items-center justify-center flex-shrink-0 relative z-10">02</div>
            <div class="md:mt-7">
              <h3 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">Add and assign tasks</h3>
              <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-[28ch]">
                Create tasks, assign owners, set priorities and due dates. Move them as work progresses.
              </p>
            </div>
            <div class="absolute left-[25px] top-[52px] bottom-0 w-px bg-zinc-200 dark:bg-zinc-800 md:hidden" aria-hidden="true"></div>
          </div>

          <div class="flex md:block gap-5 md:gap-0" data-reveal data-reveal-delay="4">
            <div class="w-[52px] h-[52px] rounded-2xl bg-zinc-900 dark:bg-zinc-100 text-zinc-50 dark:text-zinc-900 font-bold text-base flex items-center justify-center flex-shrink-0 relative z-10">03</div>
            <div class="md:mt-7">
              <h3 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-2">Ship together</h3>
              <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-[28ch]">
                Watch tasks complete in real time. See what shipped, what's blocked, and what's next.
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>


  <%# ── Tech Highlights ────────────────────────────────────────── %>
