<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">Reset your password</h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Enter your email and we'll send you a reset link</p>
    </div>

    <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "w-full px-3 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors",
            placeholder: "you@example.com" %>
      </div>

      <%= form.submit "Send reset instructions", class: "w-full btn-primary justify-center cursor-pointer" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-zinc-500 dark:text-zinc-400">
      <%= link_to "← Back to sign in", new_session_path, class: "font-medium text-amber-600 dark:text-amber-400 hover:underline" %>
    </p>
  </div>
</div>
