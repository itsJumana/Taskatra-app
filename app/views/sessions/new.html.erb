<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">Welcome back</h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Sign in to your Taskatra account</p>
    </div>

    <%= form_with url: session_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "w-full px-3 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors",
            placeholder: "you@example.com" %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <%= form.label :password, "Password", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
          <%= link_to "Forgot password?", new_password_path, class: "text-xs font-medium text-amber-600 dark:text-amber-400 hover:underline" %>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
            class: "w-full px-3 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-colors",
            placeholder: "Enter your password", maxlength: 72 %>
      </div>

      <%= form.submit "Sign in", class: "w-full btn-primary justify-center cursor-pointer" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-zinc-500 dark:text-zinc-400">
      Don't have an account?
      <%= link_to "Create one", new_registration_path, class: "font-medium text-amber-600 dark:text-amber-400 hover:underline" %>
    </p>
  </div>
</div>
